# Notion Integration Token
# Get this from https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxx

# Notion Database ID
# The ID of the database to sync to (found in the URL after /d/)
NOTION_DATABASE_ID=xxx

# Dify API Configuration
DIFY_API_KEY=dataset-xxx
DIFY_BASE_URL=http://your-server/v1
DIFY_KNOWLEDGE_BASE_ID=xxx
DOC_DIR=/path/to/your/documents
DOC_SUFFIX=pdf
